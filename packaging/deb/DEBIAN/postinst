#!/bin/sh
set -e
# 1.0.0 shipped rmux.desktop; 1.0.1 renames it to org.rmux.Terminal.desktop.
# dpkg removes obsolete files on upgrade, but belt-and-braces for manual copies.
rm -f /usr/share/applications/rmux.desktop
update-desktop-database /usr/share/applications >/dev/null 2>&1 || true
gtk-update-icon-cache -q -t -f /usr/share/icons/hicolor >/dev/null 2>&1 || true
#DEBHELPER#
exit 0
