[Desktop Entry]
Name=cmux
GenericName=Terminal Emulator
Comment=Fast, simple, modern terminal for Linux
Exec=cmux-native %U
Icon=cmux-native
Terminal=false
Type=Application
Categories=System;TerminalEmulator;Development;
Keywords=terminal;shell;multiplexer;cmux;workspace;split;theme;
StartupNotify=true
Actions=NewWorkspace;

[Desktop Action NewWorkspace]
Name=New Workspace
Exec=cmux-native --new-workspace
