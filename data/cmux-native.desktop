[Desktop Entry]
Name=cmux
GenericName=Terminal Emulator for AI Developers
Comment=Native Ubuntu Terminal Emulator for AI-Assisted Development
Exec=cmux-native %U
Icon=cmux-native
Terminal=false
Type=Application
Categories=System;TerminalEmulator;Development;
Keywords=terminal;shell;multiplexer;cmux;ai;agent;claude;codex;prompt;
StartupNotify=true
Actions=NewWorkspace;

[Desktop Action NewWorkspace]
Name=New Workspace
Exec=cmux-native --new-workspace
