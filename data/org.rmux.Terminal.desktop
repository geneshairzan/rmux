[Desktop Entry]
Name=rmux
GenericName=Terminal Emulator
Comment=Fast, simple, modern terminal for Linux
Exec=rmux %U
Icon=rmux
Terminal=false
Type=Application
Categories=System;TerminalEmulator;Development;
Keywords=terminal;shell;multiplexer;rmux;workspace;split;theme;
StartupNotify=true
StartupWMClass=rmux
Actions=NewWorkspace;

[Desktop Action NewWorkspace]
Name=New Workspace
Exec=rmux --new-workspace
